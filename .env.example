# Copiar a .env y ajustar los valores: cp .env.example .env
# Los valores de ejemplo sirven para correr en local; no usarlos en otro entorno.

# --- PostgreSQL (superusuario del contenedor) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=ecobici
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Usuario del ETL (escritura en bronze, silver y gold) ---
ETL_DB_USER=etl
ETL_DB_PASSWORD=change-me-etl

# --- Usuario de solo lectura para BI (lectura en gold) ---
BI_DB_USER=bi_reader
BI_DB_PASSWORD=change-me-bi

# --- ETL ---
DATA_RAW_DIR=/data/raw
DATA_REFERENCE_DIR=/data/reference
LOG_LEVEL=INFO
# json en el contenedor; text para leer en la terminal
LOG_FORMAT=json

# --- dbt ---
DBT_TARGET=dev
DBT_THREADS=4

# --- Metabase ---
METABASE_PORT=3000
MB_DB_DBNAME=metabase
MB_DB_USER=metabase
MB_DB_PASSWORD=change-me-mb
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=change-me-admin1
