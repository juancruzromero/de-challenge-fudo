[sqlfluff]
dialect = postgres
# jinja alcanza para los modelos dbt sin necesitar una conexión a la base;
# se puede pasar al templater de dbt cuando exista el proyecto (T4.1).
templater = jinja
max_line_length = 100
exclude_rules = ST06

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
# Las macros del proyecto (clean_id, clean_number, ...) se expanden igual que en dbt.
load_macros_from_path = dbt/macros

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:references.keywords]
# No son palabras reservadas en Postgres y son los nombres naturales de esas columnas.
ignore_words = source, year, quarter, month, year_month, users
